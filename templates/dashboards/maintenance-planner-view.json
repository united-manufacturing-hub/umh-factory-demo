            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(\n  (AVG(EXTRACT(EPOCH FROM (ms.end_time - ms.start_time)) / 60.0))::numeric\n, 1) AS \"MTTR\"\nFROM machine_stops ms\nJOIN asset a ON a.id = ms.asset_id\nJOIN stop_reasons sr ON sr.id = ms.stop_reason_id\nWHERE a.enterprise = '${enterprise}'\n  AND a.site = '${site}'\n  AND ('${line:raw}' = 'All' OR a.line = '${line:raw}')\n  AND ms.start_time >= $__timeFrom()::timestamptz\n  AND ms.start_time <  $__timeTo()::timestamptz\n  AND ms.end_time IS NOT NULL\n  AND sr.category = 'Unplanned'",
          "refId": "A"
        }
      ],
      "title": "MTTR",
      "type": "stat"
    },
