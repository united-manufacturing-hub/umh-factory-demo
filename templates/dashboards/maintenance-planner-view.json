          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH base AS (\n  SELECT\n    a.line     AS \"Line\",\n    a.workcell AS \"Machine\",\n    COUNT(*) FILTER (WHERE sr.category = 'Unplanned') AS stops,\n    ROUND(\n      (\n        (EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)) / 60.0\n         - COALESCE(SUM(EXTRACT(EPOCH FROM (\n             LEAST(COALESCE(ms.end_time, $__timeTo()::timestamptz), $__timeTo()::timestamptz)\n             - ms.start_time\n           )) / 60.0) FILTER (WHERE sr.category = 'Unplanned'), 0))\n        / NULLIF(COUNT(*) FILTER (WHERE sr.category = 'Unplanned'), 0)\n      )::numeric\n    , 1) AS mtbf,\n    ROUND(\n      (AVG(EXTRACT(EPOCH FROM (ms.end_time - ms.start_time)) / 60.0)\n       FILTER (WHERE sr.category = 'Unplanned' AND ms.end_time IS NOT NULL)\n      )::numeric\n    , 1) AS mttr,\n    COALESCE(ROUND(\n      (SUM(EXTRACT(EPOCH FROM (\n        LEAST(COALESCE(ms.end_time, $__timeTo()::timestamptz), $__timeTo()::timestamptz)\n        - ms.start_time\n      )) / 60.0) FILTER (WHERE sr.category = 'Unplanned')\n      )::numeric\n    , 1), 0) AS downtime,\n    COALESCE(ROUND(\n      (SUM(EXTRACT(EPOCH FROM (\n        LEAST(COALESCE(ms.end_time, $__timeTo()::timestamptz), $__timeTo()::timestamptz)\n        - ms.start_time\n      )) / 60.0) FILTER (WHERE sr.category = 'Planned')\n      )::numeric\n    , 1), 0) AS planned_maint,\n    MAX(ms.start_time) FILTER (WHERE sr.category = 'Unplanned') AS last_fault\n  FROM machine_stops ms\n  JOIN asset a ON a.id = ms.asset_id\n  JOIN stop_reasons sr ON sr.id = ms.stop_reason_id\n  WHERE a.enterprise = '${enterprise}'\n    AND a.site = '${site}'\n    AND ('${line:raw}' = 'All' OR a.line = '${line:raw}')\n    AND ms.start_time >= $__timeFrom()::timestamptz\n    AND ms.start_time <  $__timeTo()::timestamptz\n  GROUP BY a.line, a.workcell\n)\nSELECT\n  \"Line\",\n  \"Machine\",\n  stops         AS \"Stops\",\n  mtbf          AS \"MTBF\",\n  mttr          AS \"MTTR\",\n  downtime      AS \"Downtime\",\n  CASE\n    WHEN planned_maint + downtime = 0 THEN NULL\n    ELSE ROUND((planned_maint / (planned_maint + downtime) * 100)::numeric, 1)\n  END AS \"Planned Maintenance %\",\n  ROUND((EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - last_fault)) / 86400.0)::numeric, 1) AS \"Days Since Last Fault\"\nFROM base\nORDER BY stops DESC, \"Machine\"",
          "refId": "A"
        }
      ],
      "title": "Machine Reliability Summary",
      "type": "table"
    },
