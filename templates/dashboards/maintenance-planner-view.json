      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH machine_count AS (\n  SELECT GREATEST(COUNT(DISTINCT ms.asset_id), 1) AS cnt\n  FROM machine_stops ms\n  JOIN asset a ON a.id = ms.asset_id\n  JOIN stop_reasons sr ON sr.id = ms.stop_reason_id\n  WHERE a.enterprise = '${enterprise}'\n    AND a.site = '${site}'\n    AND ('${line:raw}' = 'All' OR a.line = '${line:raw}')\n    AND ms.start_time >= $__timeFrom()::timestamptz\n    AND ms.start_time <  $__timeTo()::timestamptz\n    AND sr.category = 'Unplanned'\n),\nstats AS (\n  SELECT\n    COUNT(*) AS fault_count,\n    COALESCE(SUM(EXTRACT(EPOCH FROM (\n      LEAST(COALESCE(ms.end_time, $__timeTo()::timestamptz), $__timeTo()::timestamptz)\n      - ms.start_time\n    )) / 60.0), 0) AS fault_downtime_min\n  FROM machine_stops ms\n  JOIN asset a ON a.id = ms.asset_id\n  JOIN stop_reasons sr ON sr.id = ms.stop_reason_id\n  WHERE a.enterprise = '${enterprise}'\n    AND a.site = '${site}'\n    AND ('${line:raw}' = 'All' OR a.line = '${line:raw}')\n    AND ms.start_time >= $__timeFrom()::timestamptz\n    AND ms.start_time <  $__timeTo()::timestamptz\n    AND sr.category = 'Unplanned'\n)\nSELECT ROUND(\n  (\n    (mc.cnt * EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)) / 60.0 - s.fault_downtime_min)\n    / NULLIF(s.fault_count, 0)\n  )::numeric\n, 1) AS \"MTBF\"\nFROM stats s, machine_count mc",
          "refId": "A"
        }
      ],
      "title": "MTBF",
      "type": "stat"
    },
