      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH totals AS (\n  SELECT\n    COALESCE(SUM(EXTRACT(EPOCH FROM (\n      LEAST(COALESCE(ms.end_time, $__timeTo()::timestamptz), $__timeTo()::timestamptz)\n      - ms.start_time\n    )) / 60.0) FILTER (WHERE sr.category = 'Unplanned'), 0) AS unplanned_min,\n    COALESCE(SUM(EXTRACT(EPOCH FROM (\n      LEAST(COALESCE(ms.end_time, $__timeTo()::timestamptz), $__timeTo()::timestamptz)\n      - ms.start_time\n    )) / 60.0) FILTER (WHERE sr.category = 'Planned'), 0) AS planned_min\n  FROM machine_stops ms\n  JOIN asset a ON a.id = ms.asset_id\n  JOIN stop_reasons sr ON sr.id = ms.stop_reason_id\n  WHERE a.enterprise = '${enterprise}'\n    AND a.site = '${site}'\n    AND ('${line:raw}' = 'All' OR a.line = '${line:raw}')\n    AND ms.start_time >= $__timeFrom()::timestamptz\n    AND ms.start_time <  $__timeTo()::timestamptz\n)\nSELECT CASE\n  WHEN planned_min + unplanned_min = 0 THEN NULL\n  ELSE ROUND((planned_min / (planned_min + unplanned_min) * 100)::numeric, 1)\nEND AS \"Planned Maintenance %\"\nFROM totals",
          "refId": "A"
        }
      ],
      "title": "Planned Maintenance %",
      "type": "stat"
    },
