      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH time_range AS (SELECT $__timeFrom()::timestamptz as t_start, $__timeTo()::timestamptz as t_end), shift_periods AS (SELECT GREATEST(s.start_time, tr.t_start) as period_start, LEAST(s.end_time, tr.t_end) as period_end FROM shifts s, time_range tr WHERE s.start_time < tr.t_end AND s.end_time > tr.t_start) SELECT CASE WHEN COUNT(*) > 0 THEN SUM(EXTRACT(EPOCH FROM (period_end - period_start)) / 60) ELSE NULL END as planned_minutes FROM shift_periods",
          "refId": "A"
        }
      ],
      "title": "Planned Time",
      "type": "stat"
    },
