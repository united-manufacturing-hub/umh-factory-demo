          "rawSql": "WITH good_deltas AS (SELECT origin, MAX(value) FILTER (WHERE timestamp <= $__timeTo()::timestamptz) as end_v, MAX(value) FILTER (WHERE timestamp < $__timeFrom()::timestamptz) as start_v FROM tag WHERE name = 'GoodParts' AND asset_id = (SELECT get_asset_id_immutable('__ENTERPRISE__', '__SITE__', '__AREA__', '__LINE__', '__WORKCELL__')) GROUP BY origin), scrap_deltas AS (SELECT origin, MAX(value) FILTER (WHERE timestamp <= $__timeTo()::timestamptz) as end_v, MAX(value) FILTER (WHERE timestamp < $__timeFrom()::timestamptz) as start_v FROM tag WHERE name = 'ScrapParts' AND asset_id = (SELECT get_asset_id_immutable('__ENTERPRISE__', '__SITE__', '__AREA__', '__LINE__', '__WORKCELL__')) GROUP BY origin) SELECT COALESCE((SELECT SUM(GREATEST(COALESCE(end_v, 0) - COALESCE(start_v, 0), 0)) FROM good_deltas), 0) + COALESCE((SELECT SUM(GREATEST(COALESCE(end_v, 0) - COALESCE(start_v, 0), 0)) FROM scrap_deltas), 0) as total_parts",
