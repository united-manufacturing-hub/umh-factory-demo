          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  order_id as \"Order\",\n  customer as \"Customer\",\n  part_number as \"Part\",\n  quantity_completed || ' / ' || quantity as \"Completed / Target\",\n  progress_pct as \"Progress\",\n  status as \"Status\"\nFROM v_order_progress\nWHERE enterprise = '${enterprise}'\n  AND site = '${site}'\n  AND line = '${line}'\n  AND status IN ('IN_PROGRESS', 'RELEASED', 'CREATED')\nORDER BY started_at DESC\nLIMIT 5",
          "refId": "A"
        }
      ],
      "title": "Current Orders",
      "type": "table"
