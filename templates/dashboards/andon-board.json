            "properties": [
              { "id": "custom.width", "value": 100 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": 0 },
                    { "color": "yellow", "value": 5 },
                    { "color": "orange", "value": 15 },
                    { "color": "red", "value": 30 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "unit", "value": "m" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Category" },
            "properties": [
              { "id": "custom.width", "value": 100 },
              {
                "id": "mappings",
                "value": [
                  { "options": { "Unplanned": { "color": "red", "index": 0 } }, "type": "value" },
                  { "options": { "Planned": { "color": "blue", "index": 1 } }, "type": "value" },
                  { "options": { "External": { "color": "orange", "index": 2 } }, "type": "value" },
                  { "options": { "Unknown": { "color": "gray", "index": 3 } }, "type": "value" }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Machine" },
            "properties": [
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Reason" },
            "properties": [
              { "id": "custom.width", "value": 150 }
            ]
          }
        ]
      },
