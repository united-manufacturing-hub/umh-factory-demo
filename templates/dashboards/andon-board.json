      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  workcell as \"Machine\",\n  reason_name as \"Reason\",\n  category as \"Category\",\n  ROUND(duration_mins::numeric, 1) as \"Duration\",\n  TO_CHAR(start_time, 'HH24:MI') as \"Started\",\n  COALESCE(notes, '-') as \"Notes\"\nFROM v_active_issues\nWHERE enterprise = '${enterprise}'\n  AND site = '${site}'\n  AND line = '${line}'\nORDER BY duration_mins DESC",
          "refId": "A"
        }
      ],
      "title": "Active Stops",
      "type": "table"
