          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND((COALESCE(avail, 87.5) / 100.0 * LEAST(COALESCE(perf, 90), 100) / 100.0 * COALESCE(qual, 100) / 100.0 * 100)::numeric, 1) as \"Order OEE\" FROM (SELECT (SELECT COUNT(*) FILTER (WHERE t.value = 'RUNNING') * 100.0 / NULLIF(COUNT(*), 0) FROM tag_string t WHERE t.asset_id = po.asset_id AND t.name = 'State' AND t.timestamp >= po.started_at) as avail, CASE WHEN (po.quantity_completed + po.quantity_scrap) > 0 THEN (po.quantity_completed + po.quantity_scrap) * 100.0 / NULLIF(EXTRACT(EPOCH FROM (NOW() - po.started_at)) / 60.0, 0) ELSE 0 END as perf, CASE WHEN (po.quantity_completed + po.quantity_scrap) > 0 THEN po.quantity_completed * 100.0 / (po.quantity_completed + po.quantity_scrap) ELSE 100 END as qual FROM production_orders po WHERE po.order_id = '${order}') sub",
          "refId": "A"
        }
      ],
      "title": "Order OEE: ${order}",
      "type": "gauge"
