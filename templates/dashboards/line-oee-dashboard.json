          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH order_info AS (SELECT quantity_completed + quantity_scrap as actual_parts, EXTRACT(EPOCH FROM (COALESCE(CASE WHEN status = 'COMPLETED' THEN timestamp END, NOW()) - started_at)) as elapsed_seconds, started_at, COALESCE(CASE WHEN status = 'COMPLETED' THEN timestamp END, NOW()) as end_time FROM production_orders WHERE order_id = '${order}' AND started_at IS NOT NULL), cycle AS (SELECT COALESCE(get_cycle_time_avg('__ENTERPRISE__', '__SITE__', '__AREA__', '__LINE__', '', oi.started_at, oi.end_time), 5) as avg_ct_seconds FROM order_info oi) SELECT LEAST(ROUND((oi.actual_parts * c.avg_ct_seconds * 100.0 / NULLIF(oi.elapsed_seconds, 0))::numeric, 1), 100) as \"Performance\" FROM order_info oi, cycle c",
          "refId": "A"
        }
      ],
