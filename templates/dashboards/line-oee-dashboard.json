          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH parts AS (SELECT COALESCE(SUM(GREATEST(COALESCE(end_v, 0) - COALESCE(start_v, 0), 0)), 0) as total_parts FROM (SELECT asset_id, origin, MAX(value) FILTER (WHERE timestamp <= $__timeTo()::timestamptz) as end_v, MAX(value) FILTER (WHERE timestamp < $__timeFrom()::timestamptz) as start_v FROM tag WHERE asset_id IN (SELECT get_asset_ids_stable('__ENTERPRISE__', '__SITE__', '__AREA__', '__LINE__', '')) AND name IN ('GoodParts', 'ScrapParts') GROUP BY asset_id, origin) sub), running AS (SELECT COUNT(*) as running_count, (SELECT COUNT(*) FROM tag_string WHERE asset_id IN (SELECT get_asset_ids_stable('__ENTERPRISE__', '__SITE__', '__AREA__', '__LINE__', '')) AND name = 'State' AND timestamp BETWEEN $__timeFrom() AND $__timeTo()) as total_count FROM tag_string WHERE asset_id IN (SELECT get_asset_ids_stable('__ENTERPRISE__', '__SITE__', '__AREA__', '__LINE__', '')) AND name = 'State' AND value = 'RUNNING' AND timestamp BETWEEN $__timeFrom() AND $__timeTo()), cycle AS (SELECT COALESCE(AVG(value), 5) as avg_ct FROM tag WHERE asset_id IN (SELECT get_asset_ids_stable('__ENTERPRISE__', '__SITE__', '__AREA__', '__LINE__', '')) AND name = 'CycleTime' AND value > 0 AND timestamp BETWEEN $__timeFrom() AND $__timeTo()) SELECT LEAST(ROUND((p.total_parts * 100.0 / NULLIF(r.running_count * EXTRACT(EPOCH FROM ($__timeTo()::timestamp - $__timeFrom()::timestamp)) / NULLIF(r.total_count, 1) / NULLIF(c.avg_ct, 1), 0))::numeric, 1), 100) as \"Performance\" FROM parts p, running r, cycle c",
          "refId": "A"
        }
      ],
      "title": "Performance",
      "type": "gauge"
