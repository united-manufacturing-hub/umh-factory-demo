          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND((COALESCE(avail, 87.5) / 100.0 * LEAST(COALESCE(perf, 90), 100) / 100.0 * COALESCE(qual, 100) / 100.0 * 100)::numeric, 1) as \"Order OEE\" FROM (SELECT LEAST(COALESCE((SELECT SUM(mv.running_minutes) FROM mv_runtime_hourly mv WHERE mv.asset_id = po.asset_id AND mv.bucket >= po.started_at AND mv.bucket < COALESCE(po.completed_at, NOW())), 0) * 100.0 / NULLIF(EXTRACT(EPOCH FROM (COALESCE(po.completed_at, NOW()) - po.started_at)) / 60.0, 0), 100) as avail, CASE WHEN (po.quantity_completed + po.quantity_scrap) > 0 THEN (po.quantity_completed + po.quantity_scrap) * 100.0 / NULLIF(EXTRACT(EPOCH FROM (NOW() - po.started_at)) / 60.0, 0) ELSE 0 END as perf, CASE WHEN (po.quantity_completed + po.quantity_scrap) > 0 THEN po.quantity_completed * 100.0 / (po.quantity_completed + po.quantity_scrap) ELSE 100 END as qual FROM production_orders po WHERE po.order_id = '${order}' AND po.started_at IS NOT NULL) sub",
          "refId": "A"
        }
      ],
      "title": "Order OEE: ${order}",
