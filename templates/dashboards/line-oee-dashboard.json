            "uid": "df9o2whw2o7wgb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH state_data AS (SELECT COUNT(*) as total_states, COUNT(*) FILTER (WHERE t.value = 'RUNNING') as running_count FROM tag_string t WHERE asset_id IN (SELECT get_asset_ids_stable('__ENTERPRISE__', '__SITE__', '__AREA__', '__LINE__', '')) AND t.name = 'State' AND t.timestamp BETWEEN $__timeFrom() AND $__timeTo()), parts_data AS (SELECT COALESCE(SUM(GREATEST(COALESCE(end_good, 0) - COALESCE(start_good, 0), 0)), 0) as good_delta, COALESCE(SUM(GREATEST(COALESCE(end_scrap, 0) - COALESCE(start_scrap, 0), 0)), 0) as scrap_delta FROM (SELECT asset_id, origin, MAX(value) FILTER (WHERE name = 'GoodParts' AND timestamp <= $__timeTo()::timestamptz) as end_good, MAX(value) FILTER (WHERE name = 'GoodParts' AND timestamp < $__timeFrom()::timestamptz) as start_good, MAX(value) FILTER (WHERE name = 'ScrapParts' AND timestamp <= $__timeTo()::timestamptz) as end_scrap, MAX(value) FILTER (WHERE name = 'ScrapParts' AND timestamp < $__timeFrom()::timestamptz) as start_scrap FROM tag WHERE asset_id IN (SELECT get_asset_ids_stable('__ENTERPRISE__', '__SITE__', '__AREA__', '__LINE__', '')) AND name IN ('GoodParts', 'ScrapParts') GROUP BY asset_id, origin) sub) SELECT ROUND((((running_pct / 100.0) * LEAST(COALESCE(perf, 0), 100) / 100.0 * COALESCE(qual, 100) / 100.0) * 100)::numeric, 1) as \"OEE\" FROM (SELECT CASE WHEN s.total_states > 0 THEN s.running_count * 100.0 / s.total_states ELSE 0 END as running_pct, CASE WHEN (p.good_delta + p.scrap_delta) > 0 THEN (p.good_delta + p.scrap_delta) * 100.0 / NULLIF(s.running_count * 1.0 / NULLIF(s.total_states, 0) * EXTRACT(EPOCH FROM ($__timeTo()::timestamp - $__timeFrom()::timestamp)) / 60.0, 0) ELSE 0 END as perf, CASE WHEN (p.good_delta + p.scrap_delta) > 0 THEN p.good_delta * 100.0 / (p.good_delta + p.scrap_delta) ELSE 100 END as qual FROM state_data s, parts_data p) sub",
          "refId": "A"
        }
      ],
      "title": "Overall OEE",
      "type": "gauge"
    },
