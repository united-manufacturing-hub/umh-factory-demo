      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ranked AS (\n  SELECT\n    COALESCE(sr.name, 'Unspecified') as reason,\n    ROUND(SUM(EXTRACT(EPOCH FROM (COALESCE(ms.end_time, NOW()) - ms.start_time)) / 60.0), 1) as duration,\n    COUNT(*) as cnt,\n    ROW_NUMBER() OVER (ORDER BY SUM(EXTRACT(EPOCH FROM (COALESCE(ms.end_time, NOW()) - ms.start_time))) DESC) as rn,\n    COUNT(*) OVER () as total\n  FROM machine_stops ms\n  JOIN asset a ON a.id = ms.asset_id\n  LEFT JOIN stop_reasons sr ON sr.id = ms.stop_reason_id\n  WHERE a.enterprise = '${enterprise}'\n    AND a.site = '${site}'\n    AND a.line = '${line:raw}'\n    AND ms.start_time BETWEEN (NOW() - INTERVAL '${time_period}') AND NOW()\n  GROUP BY COALESCE(sr.name, 'Unspecified')\n)\nSELECT\n  reason as \"Reason\",\n  duration as \"Duration (min)\",\n  cnt as \"Count\"\nFROM ranked\nORDER BY\n  CASE\n    WHEN rn = 1 THEN 0\n    WHEN rn % 2 = 0 THEN -(rn / 2)\n    ELSE (rn + 1) / 2\n  END",
          "refId": "A"
        }
      ],
      "title": "Stop Duration by Reason",
      "type": "barchart"
    },
