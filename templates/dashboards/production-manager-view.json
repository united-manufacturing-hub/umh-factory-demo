      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH time_buckets AS (\n  SELECT\n    time_bucket('1 hour', t.timestamp) as bucket,\n    a.workcell,\n    SUM(CASE WHEN t.name = 'good_count' THEN t.value ELSE 0 END) as good_max,\n    SUM(CASE WHEN t.name = 'scrap_count' THEN t.value ELSE 0 END) as scrap_max\n  FROM tag t\n  JOIN asset a ON a.id = t.asset_id\n  WHERE a.enterprise = '${enterprise}'\n    AND a.site = '${site}'\n    AND a.line = '${line:raw}'\n    AND a.workcell != ''\n    AND t.name IN ('good_count', 'scrap_count')\n    AND t.timestamp BETWEEN (NOW() - INTERVAL '${time_period}') AND NOW()\n  GROUP BY bucket, a.workcell\n)\nSELECT\n  bucket as time,\n  workcell as metric,\n  CASE\n    WHEN (good_max + scrap_max) > 0 THEN ROUND((scrap_max * 100.0 / (good_max + scrap_max))::numeric, 2)\n    ELSE 0\n  END as value\nFROM time_buckets\nORDER BY bucket",
          "refId": "A"
        }
      ],
      "title": "Scrap Rate Over Time by Machine",
      "type": "timeseries"
    },
