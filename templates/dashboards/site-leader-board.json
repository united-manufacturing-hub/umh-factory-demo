          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(sr.name, 'Unspecified') as \"Reason\",\n  COUNT(*)::int as \"Count\"\nFROM machine_stops ms\nJOIN asset a ON a.id = ms.asset_id\nLEFT JOIN stop_reasons sr ON sr.id = ms.stop_reason_id\nWHERE a.enterprise = '${enterprise}'\n  AND a.site = '${site}'\n  AND ('${line}' = 'All' OR a.line = '${line}')\n  AND ms.start_time > NOW() - INTERVAL '7 days'\nGROUP BY sr.name\nORDER BY COUNT(*) DESC\nLIMIT 10",
          "refId": "A"
        }
      ],
      "title": "Top Downtime Reasons (Pareto)",
      "type": "barchart"
