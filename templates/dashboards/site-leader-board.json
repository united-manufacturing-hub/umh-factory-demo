        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  v.line as \"Line\",\n  CASE WHEN (v.good_parts + v.scrap_parts) > 0 THEN ROUND((v.scrap_parts * 100.0 / (v.good_parts + v.scrap_parts))::numeric, 2) ELSE 0 END as \"Scrap Rate\"\nFROM v_oee_by_asset v\nWHERE v.enterprise = '${enterprise}'\n  AND v.site = '${site}'\n  AND ('${line}' = 'All' OR v.line = '${line}')\nGROUP BY v.line, v.good_parts, v.scrap_parts\nORDER BY \"Scrap Rate\" DESC",
          "refId": "A"
        }
      ],
      "title": "Scrap Rate by Line",
      "type": "barchart"
