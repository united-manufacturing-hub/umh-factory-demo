          "rawQuery": true,
          "rawSql": "SELECT\n  l.line as \"Line\",\n  COALESCE(get_availability('${enterprise}', '${site}', '', l.line, '', (NOW() - INTERVAL '24 hours')::timestamptz, NOW()), 0) as \"Availability\",\n  COALESCE(get_performance('${enterprise}', '${site}', '', l.line, '', (NOW() - INTERVAL '24 hours')::timestamptz, NOW()), 0) as \"Performance\",\n  COALESCE(get_quality('${enterprise}', '${site}', '', l.line, '', (NOW() - INTERVAL '24 hours')::timestamptz, NOW()), 100) as \"Quality\",\n  COALESCE(get_oee('${enterprise}', '${site}', '', l.line, '', (NOW() - INTERVAL '24 hours')::timestamptz, NOW()), 0) as \"OEE\"\nFROM (SELECT DISTINCT line FROM asset WHERE enterprise = '${enterprise}' AND site = '${site}' AND workcell != '' AND ('${line:raw}' = 'All' OR line = '${line:raw}')) l\nORDER BY l.line",
          "refId": "A"
        }
      ],
      "title": "OEE Breakdown by Line",
