      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  l.line as \"Line\",\n  CASE WHEN (d.good + d.scrap) > 0 THEN ROUND((d.scrap * 100.0 / (d.good + d.scrap))::numeric, 2) ELSE 0 END as \"Scrap Rate\"\nFROM (SELECT DISTINCT line FROM asset WHERE enterprise = '${enterprise}' AND site = '${site}' AND workcell != '' AND ('${line:raw}' = 'All' OR line = '${line:raw}')) l,\nLATERAL (SELECT\n  get_counter_delta('${enterprise}', '${site}', '', l.line, '', 'good_count', (NOW() - INTERVAL '24 hours')::timestamptz, NOW()) as good,\n  get_counter_delta('${enterprise}', '${site}', '', l.line, '', 'scrap_count', (NOW() - INTERVAL '24 hours')::timestamptz, NOW()) as scrap\n) d\nORDER BY \"Scrap Rate\" DESC",
          "refId": "A"
        }
      ],
      "title": "Scrap Rate by Line",
      "type": "barchart"
    },
