        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  a.line AS \"Line\",\n  COALESCE(SUM(po.quantity_completed), 0)::int AS \"Actual\",\n  COALESCE(SUM(po.quantity), 0)::int AS \"Target\"\nFROM production_orders po\nJOIN asset a ON a.id = po.asset_id\nWHERE a.enterprise = '${enterprise}'\n  AND a.site = '${site}'\n  AND ('${line:raw}' = 'All' OR a.line = '${line:raw}')\nGROUP BY a.line\nORDER BY a.line",
          "refId": "A"
        }
      ],
      "title": "Production vs Target by Line",
      "type": "barchart"
