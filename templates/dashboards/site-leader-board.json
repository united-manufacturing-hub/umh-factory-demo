        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  v.line as \"Line\",\n  COALESCE(SUM(v.good_parts)::int, 0) as \"Actual\",\n  COALESCE(SUM(po.quantity), 0)::int as \"Target\"\nFROM v_oee_by_asset v\nLEFT JOIN production_orders po ON po.asset_id = v.asset_id AND po.status IN ('IN_PROGRESS', 'COMPLETED')\nWHERE v.enterprise = '${enterprise}'\n  AND v.site = '${site}'\n  AND ('${line}' = 'All' OR v.line = '${line}')\nGROUP BY v.line\nORDER BY v.line",
          "refId": "A"
        }
      ],
      "title": "Production vs Target by Line",
      "type": "barchart"
    },
