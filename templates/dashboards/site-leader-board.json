          "rawSql": "SELECT\n  line as \"Line\",\n  ROUND(AVG(availability_pct)::numeric, 1) as \"Availability\",\n  ROUND(AVG(performance_pct)::numeric, 1) as \"Performance\",\n  ROUND(AVG(quality_pct)::numeric, 1) as \"Quality\",\n  ROUND(AVG(oee_pct)::numeric, 1) as \"OEE\"\nFROM v_oee_by_asset\nWHERE enterprise = '${enterprise}'\n  AND site = '${site}'\n  AND ('${line}' = 'All' OR line = '${line}')\nGROUP BY line\nORDER BY line",
