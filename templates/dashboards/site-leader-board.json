          "rawSql": "SELECT\n  line as \"Line\",\n  workcell as \"Machine\",\n  reason_name as \"Reason\",\n  category as \"Category\",\n  ROUND(duration_mins::numeric, 1) as \"Duration (min)\",\n  start_time as \"Started\",\n  notes as \"Notes\"\nFROM v_active_issues\nWHERE enterprise = '${enterprise}'\n  AND site = '${site}'\n  AND ('${line:raw}' = 'All' OR line = '${line:raw}')\nORDER BY duration_mins DESC",
