          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH produced AS (\n  SELECT COALESCE(\n    GREATEST(\n      (SELECT MAX(value) FROM tag WHERE asset_id = ${asset_id} AND name = 'GoodParts' AND timestamp <= NOW()) -\n      (SELECT COALESCE(MAX(value), 0) FROM tag WHERE asset_id = ${asset_id} AND name = 'GoodParts' AND timestamp < DATE_TRUNC('day', NOW())),\n      0\n    ), 0\n  ) as actual\n),\nplanned AS (\n  SELECT COALESCE(\n    (SELECT po.quantity FROM production_orders po WHERE po.asset_id = ${asset_id} AND po.status IN ('IN_PROGRESS', 'RELEASED') ORDER BY po.created_at DESC LIMIT 1),\n    500\n  ) as target\n)\nSELECT ROUND((p.actual * 100.0 / NULLIF(pl.target, 0))::numeric, 1) as \"vs Plan\"\nFROM produced p, planned pl",
          "refId": "A"
        }
      ],
      "title": "vs Plan",
      "type": "gauge"
    },
