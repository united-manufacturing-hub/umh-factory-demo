      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(po.order_id, 'No Active Order') as \"Current Order\",\n  COALESCE(po.part_number, '-') as \"Part\",\n  po.quantity_completed::text || ' / ' || po.quantity::text as \"Progress\"\nFROM production_orders po\nJOIN asset a ON a.id = po.asset_id\nWHERE a.enterprise = '${enterprise}'\n  AND a.site = '${site}'\n  AND a.line = '${line}'\n  AND po.status IN ('IN_PROGRESS', 'RELEASED', 'CREATED')\nORDER BY po.created_at DESC\nLIMIT 1",
          "refId": "A"
        }
      ],
      "title": "Current Order",
      "type": "stat"
    },
