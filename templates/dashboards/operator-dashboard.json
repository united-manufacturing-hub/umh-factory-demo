        "afterRender": "const buttons = context.element.querySelectorAll('button[data-state]');\nbuttons.forEach(btn => {\n  btn.style.opacity = '0.6';\n  btn.style.cursor = 'default';\n  btn.title = 'Machine state control (display only)';\n});",
        "content": "<div style=\"display: flex; justify-content: center; align-items: center; gap: 16px; height: 100%; flex-wrap: wrap; padding: 8px;\">\n  <button data-state=\"RUNNING\" style=\"background-color: #73BF69; color: white; border: none; padding: 16px 32px; font-size: 16px; font-weight: bold; border-radius: 8px; cursor: pointer; min-width: 140px;\">▶ RUNNING</button>\n  <button data-state=\"IDLE\" style=\"background-color: #FADE2A; color: black; border: none; padding: 16px 32px; font-size: 16px; font-weight: bold; border-radius: 8px; cursor: pointer; min-width: 140px;\">⏸ IDLE</button>\n  <button data-state=\"SETUP\" style=\"background-color: #FF9830; color: white; border: none; padding: 16px 32px; font-size: 16px; font-weight: bold; border-radius: 8px; cursor: pointer; min-width: 140px;\">⚙ SETUP</button>\n  <button data-state=\"PLANNED STOP\" style=\"background-color: #5794F2; color: white; border: none; padding: 16px 32px; font-size: 16px; font-weight: bold; border-radius: 8px; cursor: pointer; min-width: 140px;\">📅 PLANNED</button>\n  <button data-state=\"UNPLANNED STOP\" style=\"background-color: #F2495C; color: white; border: none; padding: 16px 32px; font-size: 16px; font-weight: bold; border-radius: 8px; cursor: pointer; min-width: 140px;\">⚠ UNPLANNED</button>\n</div>",
        "defaultContent": "Loading...",
